font-family = MonaspiceNe Nerd Font Mono
font-style-bold = MonaspiceNe Nerd Font Mono Bold
font-style-italic = MonaspiceNe Nerd Font Mono Italic
font-style-bold-italic = MonaspiceNe Nerd Font Mono Bold Italic
font-size = 15
font-synthetic-style = true
font-thicken = true
font-thicken-strength = 255

# theme = "Tomorrow Night Eighties"
# theme = "tokyonight_moon"
theme = "JetBrains Darcula"

# config-file = ghostty-theme

cursor-style = "block"
cursor-style-blink = true

clipboard-trim-trailing-spaces = true

mouse-hide-while-typing = true

window-colorspace = display-p3

background-blur = true
background-opacity = 0.95
